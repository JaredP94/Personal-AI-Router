{
  "engine": "omlx",
  "display_name": "oMLX",
  "manifest_version": 1,
  "detect": [
    "~/.omlx/bin/omlx",
    "/opt/homebrew/bin/omlx",
    "/usr/local/bin/omlx"
  ],
  "detect_requires": ["/Applications/oMLX.app/Contents/MacOS/omlx-cli"],
  "install": {
    "fetch_variants": [
      {
        "url": "https://github.com/jundot/omlx/releases/download/v0.7.3/oMLX-0.7.3-macos26-27.dmg",
        "sha256": "2acfde41aeac0b022dbca803ca109437f3ccaf0c33f3415881526b985bee86f2",
        "min_os_version": 26
      },
      {
        "url": "https://github.com/jundot/omlx/releases/download/v0.7.3/oMLX-0.7.3-macos15-sequoia.dmg",
        "sha256": "cd5e3b454798a002f32ef2f3bf06ae033ea2f4e5b02aa039a2c68445498605f1",
        "min_os_version": 15
      }
    ],
    "disk_image": {
      "app": "oMLX.app",
      "into": "/Applications",
      "open": true
    },
    "creates": "/Applications/oMLX.app",
    "mode": "user"
  },
  "models_dir": "~/.omlx/models",
  "uninstall": {
    "cli_roots": [
      "~/.omlx/bin"
    ],
    "run": [
      "/bin/sh",
      "-c",
      "pkill -f '^/Applications/oMLX.app/Contents/MacOS/oMLX' 2>/dev/null; sleep 2; exit 0"
    ],
    "remove": [
      "/Applications/oMLX.app",
      "~/.omlx/bin/omlx",
      "~/.omlx/bin/omlx-cluster-python"
    ]
  },
  "runtime": {
    "mode": "command",
    "port": 1235,
    "bind": "127.0.0.1",
    "start": [["{cli}", "start"]],
    "stop": { "cmd": ["{cli}", "stop"] },
    "ready": { "http": "http://127.0.0.1:{port}/health", "status": 200, "timeout_s": 45 },
    "health": { "http": "http://127.0.0.1:{port}/health", "status": 200, "interval_s": 10 }
  },
  "platforms": {
    "darwin/arm64": {}
  },
  "actions": {
    "list_models": {
      "description": "List models downloaded and available in oMLX.",
      "http": { "method": "GET", "path": "/v1/models" },
      "result": { "array": "data", "field": "id" }
    },
    "loaded_models": {
      "description": "List models currently active in memory.",
      "http": { "method": "GET", "path": "/v1/models/status" },
      "result": { "array": "models", "field": "id", "match": { "field": "loaded", "true": true } }
    },
    "chat": {
      "timeout_s": 600,
      "description": "OpenAI-compatible chat completions.",
      "http": { "method": "POST", "path": "/v1/chat/completions", "body_schema": { "model": "string", "messages": "array" } }
    },
    "load_model": {
      "timeout_s": 600,
      "description": "Load a downloaded model into memory (params: {\"model\": \"<name>\"}).",
      "http": { "method": "POST", "path": "/v1/models/{model}/load" }
    },
    "unload_model": {
      "description": "Unload a model from memory (params: {\"model\": \"<name>\"}).",
      "http": { "method": "POST", "path": "/v1/models/{model}/unload" }
    }
  }
}
